TRACCAR_URL=https://your-traccar-server.example.com
TRACCAR_EMAIL=change-me@example.com
TRACCAR_PASSWORD=change-me-traccar-password
# Single origin, or comma-separated for split hosting (Hostinger + DigitalOcean UI).
# Example: FRONTEND_URL=https://your-hostinger-domain.com,http://168.144.183.130
FRONTEND_URL=http://localhost:3000
ORS_API_KEY=change-me-ors-api-key

DB_USER=root
DB_PASSWORD=change-me-db-password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fleet_tracker

JWT_SECRET=change-me-jwt-secret
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
# Super Admin bootstrap (python -m tracker_backend.scripts.seed_super_admin). No default.
# SUPER_ADMIN_USERNAME=superadmin
# SUPER_ADMIN_PASSWORD=change-me-super-admin-password
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PASSWORD_ENC_KEY=change-me-generate-a-fernet-key
LOGIN_RATE_LIMIT_CALLS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Required only when running the historical user-password backfill migration
DEFAULT_USER_PASSWORD=change-me-default-user-password
